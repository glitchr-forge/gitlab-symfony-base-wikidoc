{% macro render_nodes(nodes, selected_document) %}
    {% import _self as self %}
    <ul class="manual-tree">
        {% for node in nodes %}
            {% set document = node.document %}
            <li class="{{ selected_document and selected_document.id == document.id ? 'selected' }}">
                <a href="{{ path('backoffice_manual', {slug: document.slug}) }}">{{ document.title }}</a>
                {% if node.children is not empty %}
                    {{ self.render_nodes(node.children, selected_document) }}
                {% endif %}
            </li>
        {% endfor %}
    </ul>
{% endmacro %}

{% import _self as self %}
{% if documents is not empty %}
    <div class="manual-menu-section">
        <div class="section">{{ 'manual.title'|trans({}, 'admin') }}</div>
        {{ self.render_nodes(documents, selected_document) }}
    </div>
{% endif %}
