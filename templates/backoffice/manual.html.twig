{% extends '@Admin/layout.html.twig' %}

{% block page_title %}{{ selected_document ? selected_document.title : 'manual.title'|trans({}, 'admin') }}{% endblock %}

{% block main_menu %}
    {{ parent() }}
    {{ include('@Wikidoc/backoffice/manual_menu.html.twig') }}
{% endblock %}

{% block content_header %}
<div class="admin-header">
    <h1>{{ 'manual.title'|trans({}, 'admin') }}</h1>
</div>
{% endblock %}

{% block content %}
<div class="card manual-content">
    {% if selected_document is not null %}
        <div class="manual-meta">{{ 'manual.last_update'|trans({}, 'admin') }}: {{ selected_document.updatedAt|date('Y-m-d H:i') }}</div>
        <h1>{{ selected_document.title }}</h1>
        {% if selected_document.excerpt is not empty %}
            <p class="manual-excerpt">{{ selected_document.excerpt }}</p>
            {% if selected_document.content is not empty %}<hr>{% endif %}
        {% endif %}
        {{ selected_document.content|wysiwyg|raw }}
    {% else %}
        <div class="empty-state">{{ 'manual.empty'|trans({}, 'admin') }}</div>
    {% endif %}
</div>
{% endblock %}
